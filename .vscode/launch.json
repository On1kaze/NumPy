{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Запуск всех заданий (main.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Запуск тестов (unittest)",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": ["discover", "-s", "tests"],
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Текущий активный файл",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}
